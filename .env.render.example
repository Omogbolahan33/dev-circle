# Render deployment variables — pick one database path below
# Use as checklist for a normal Render Web Service deployment.

NODE_ENV=production
NODE_VERSION=24.18.0

# Render sets PORT automatically. Do not hardcode it unless you have a reason.
# PORT=10000

# Public URL for this deployment. Use the Render URL first, then custom domain after DNS.
APP_URL=https://dev-circle.onrender.com
CORS_ORIGINS=https://dev-circle.onrender.com

# ─── Database — choose one ──────────────────────────────────
# Option A: Postgres / Supabase (durable — recommended for production)
# Set DATABASE_URL to your Postgres connection string. Render Postgres or
# Supabase pooled connection (6543) works here. With this set, SQLite paths
# below are ignored.
DATABASE_URL=
# DATABASE_URL is the same as POSTGRES_URL for Render Postgres:
# Render → Postgres → Connections → External Database URL
# Supabase: Project → Database → Connection string (pooled 6543, pgbouncer=true)
# Optional pool tuning:
# PG_POOL_MAX=10
# PGSSLMODE=require

# Supabase Storage for brand assets (optional — else local /tmp)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
# UPLOAD_BACKEND=supabase

# Option B: SQLite on ephemeral disk (free tier demo — data disappears on deploy/restart)
# Free Render instances do not support persistent disks. Only use for demos.
DEVCIRCLE_DB_PATH=/tmp/devcircle.db
DEVCIRCLE_SANDBOX_DB_PATH=/tmp/devcircle-sandbox.db
DEVCIRCLE_UPLOAD_DIR=/tmp/devcircle-uploads

# Required in production. Generate strong random values before deploy.
DEV_HUB_SSO_SECRET=
BOOTSTRAP_API_KEY=

DEV_HUB_TOKEN_MAX_AGE_SEC=300
DEV_HUB_AUTO_PROVISION=true
SESSION_TTL_HOURS=24
STAFF_EMAIL_DOMAINS=creditdirect.ng,fcmb.com

LOGIN_CODE_TTL_SEC=600
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_MAX_PER_WINDOW=4
LOGIN_CODE_WINDOW_SEC=900

CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
WHATSAPP_API_TOKEN=
SMS_API_KEY=

SANDBOX_ENABLED=true
# For Postgres sandbox, optional separate DB:
# DEVCIRCLE_SANDBOX_DATABASE_URL=
