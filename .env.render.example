# Render production variables
# Use this as the checklist for Render's Environment tab or Blueprint prompts.

NODE_ENV=production
NODE_VERSION=20

# Render sets PORT automatically. Do not hardcode it unless you have a reason.
# PORT=10000

# Public URL for this deployment. Use the Render URL first, then your custom
# domain after DNS is live.
APP_URL=https://dev-circle.onrender.com
CORS_ORIGINS=https://dev-circle.onrender.com

# Current runtime database.
# The codebase currently uses better-sqlite3. These paths live on the Render
# persistent disk declared in render.yaml.
DEVCIRCLE_DB_PATH=/var/data/devcircle.db
DEVCIRCLE_SANDBOX_DB_PATH=/var/data/devcircle-sandbox.db
DEVCIRCLE_UPLOAD_DIR=/var/data/uploads

# Required in production. render.yaml can generate these for a new Blueprint.
DEV_HUB_SSO_SECRET=
BOOTSTRAP_API_KEY=

DEV_HUB_TOKEN_MAX_AGE_SEC=300
DEV_HUB_AUTO_PROVISION=true
SESSION_TTL_HOURS=24
STAFF_EMAIL_DOMAINS=creditdirect.ng,fcmb.com

LOGIN_CODE_TTL_SEC=600
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_MAX_PER_WINDOW=4
LOGIN_CODE_WINDOW_SEC=900

CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
WHATSAPP_API_TOKEN=
SMS_API_KEY=

SANDBOX_ENABLED=true
