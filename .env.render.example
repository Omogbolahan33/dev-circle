# Render free deployment variables
# Use this as the checklist for a normal Render Web Service deployment.

NODE_ENV=production
NODE_VERSION=24.18.0

# Render sets PORT automatically. Do not hardcode it unless you have a reason.
# PORT=10000

# Public URL for this deployment. Use the Render URL first, then your custom
# domain after DNS is live.
APP_URL=https://dev-circle.onrender.com
CORS_ORIGINS=https://dev-circle.onrender.com

# Current runtime database.
# Free Render instances do not support persistent disks, so these paths use
# ephemeral storage. Data and uploads can disappear after deploys/restarts.
DEVCIRCLE_DB_PATH=/tmp/devcircle.db
DEVCIRCLE_SANDBOX_DB_PATH=/tmp/devcircle-sandbox.db
DEVCIRCLE_UPLOAD_DIR=/tmp/devcircle-uploads

# Required in production. Generate strong random values before deploy.
DEV_HUB_SSO_SECRET=
BOOTSTRAP_API_KEY=

DEV_HUB_TOKEN_MAX_AGE_SEC=300
DEV_HUB_AUTO_PROVISION=true
SESSION_TTL_HOURS=24
STAFF_EMAIL_DOMAINS=creditdirect.ng,fcmb.com

LOGIN_CODE_TTL_SEC=600
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_MAX_PER_WINDOW=4
LOGIN_CODE_WINDOW_SEC=900

CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=
WHATSAPP_API_TOKEN=
SMS_API_KEY=

SANDBOX_ENABLED=true
