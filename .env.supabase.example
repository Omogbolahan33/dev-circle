# Supabase deployment — copy to .env and fill in
# Get values from Supabase Dashboard → Project → Settings → API & Database

NODE_ENV=production
PORT=3000

# App URLs
APP_URL=https://your-project.supabase.co
CORS_ORIGINS=https://your-project.supabase.co,https://your-custom-domain.com

# ─── Supabase Postgres ──────────────────────────────────────
# Dashboard → Database → Connection string → URI (pooled, port 6543 for serverless)
# Use pooled connection for the app, direct (5432) for running migrations locally.
DATABASE_URL=postgres://postgres:PASSWORD@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true

# Optional: separate DB for API sandbox (else same DB, isolated by context)
# DEVCIRCLE_SANDBOX_DATABASE_URL=postgres://postgres:PASSWORD@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true

# Pool tuning for Supabase pgbouncer (defaults are fine)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
# PGSSLMODE=require is implicit when DATABASE_URL is set; use disable for local Postgres without SSL

# ─── Supabase client (for Storage) ──────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=uploads
UPLOAD_BACKEND=supabase

# ─── Auth & Sessions ────────────────────────────────────────
DEV_HUB_SSO_SECRET=generate-a-strong-random-string
DEV_HUB_TOKEN_MAX_AGE_SEC=300
DEV_HUB_AUTO_PROVISION=true
SESSION_TTL_HOURS=24
BOOTSTRAP_API_KEY=generate-another-strong-random-string
STAFF_EMAIL_DOMAINS=creditdirect.ng,fcmb.com

# ─── Login codes ────────────────────────────────────────────
LOGIN_CODE_TTL_SEC=600
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_MAX_PER_WINDOW=4
LOGIN_CODE_WINDOW_SEC=900

# ─── Outbound messaging (Customer.io) ───────────────────────
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# ─── Outbound Email Interface & Providers ───────────────────
# Active provider: auto | termii | simpu | customer_io | simulated
EMAIL_PROVIDER=auto
EMAIL_FROM=devcircle@creditdirect.ng
EMAIL_FROM_NAME="Credit Direct Dev Circle"
EMAIL_REPLY_TO=devrelations@creditdirect.ng
# Termii
TERMII_API_KEY=
TERMII_EMAIL_CONFIGURATION_ID=
# Simpu
SIMPU_API_KEY=
SIMPU_SENDER_ID=devcircle@creditdirect.ng
WHATSAPP_API_TOKEN=
SMS_API_KEY=

# ─── Other ──────────────────────────────────────────────────
SANDBOX_ENABLED=true
CORS_ORIGINS=https://your-custom-domain.com
