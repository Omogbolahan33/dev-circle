# Dev Circle configuration
# Copy to .env and fill in. In development every value below has a safe
# fallback; in production the server refuses to start without the secrets.

NODE_ENV=development
PORT=3000

# Public URL for absolute links in outbound messages. Render should set this
# to the service URL or custom domain.
APP_URL=http://localhost:3000

# ─── Database — choose one ──────────────────────────────────
# Local/dev default: SQLite (no config needed, uses ./data/devcircle.db)
# For Postgres / Supabase: set DATABASE_URL and the app switches automatically.
#
# Supabase: Project → Database → Connection string (use pooled 6543 for
# serverless/Render, direct 5432 for migrations). Example:
#   postgres://postgres:PASSWORD@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true
# Plain Postgres (Render Postgres, Neon, etc.):
#   postgres://user:password@host:5432/devcircle?sslmode=require
DATABASE_URL=
# Optional Postgres tuning (defaults are fine for Supabase)
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=10000
# DNS answer preference for the Postgres host. Hosts without an IPv6 route
# (Render, most container platforms) crash the pool with
# `connect ENETUNREACH <ipv6>:5432` when DNS lists IPv6 records first, so the
# app prefers IPv4 by default. Set `verbatim` for Node's default ordering.
# PG_DNS_RESULT_ORDER=ipv4first
# PGSSLMODE=require  # set to "disable" for local Postgres without SSL
# PG_SSL=false

# Local SQLite database paths (ignored when DATABASE_URL is set). Free Render
# deployments with SQLite use /tmp; local development can leave blank to use
# the default project data directory.
DEVCIRCLE_DB_PATH=
# For Postgres: optional separate sandbox database (else reuses DATABASE_URL with separate schema)
# DEVCIRCLE_SANDBOX_DATABASE_URL=

# ─── Supabase (optional — enables Supabase Storage for uploads) ──
# Project → Settings → API. Needed only if you want brand assets (logos,
# backgrounds, fonts) stored in Supabase Storage instead of on local disk.
# The database itself still uses DATABASE_URL above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads  # bucket for brand assets (default: uploads)
# UPLOAD_BACKEND=auto  # auto | local | supabase  (auto uses supabase when configured)

# Shared secret used to verify SSO handoff tokens minted by the Developer Hub.
# Must match the value configured on the Hub side. Required in production.
DEV_HUB_SSO_SECRET=
# Reject handoff tokens older than this many seconds (replay window)
DEV_HUB_TOKEN_MAX_AGE_SEC=300
# Create a Dev Circle profile the first time a Hub developer signs in
DEV_HUB_AUTO_PROVISION=true

# Session lifetime for Dev Circle's own tokens
SESSION_TTL_HOURS=24

# There is one sign-in form. An email on any of these domains is Credit Direct
# staff and is asked for a password; everyone else is a participant and signs
# in with a one-time code or Developer Hub SSO. Comma-separated; subdomains of
# a listed domain count too.
STAFF_EMAIL_DOMAINS=creditdirect.ng,fcmb.com

# One-time sign-in codes for participants
LOGIN_CODE_TTL_SEC=600
# Wrong guesses allowed against a single code before it is burned
LOGIN_CODE_MAX_ATTEMPTS=5
# Codes one email or phone number may request inside the window below
LOGIN_CODE_MAX_PER_WINDOW=4
LOGIN_CODE_WINDOW_SEC=900

# Customer.io transactional API. Without these, outbound email/WhatsApp/SMS
# deliveries are recorded as "simulated" rather than reported as sent.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# ─── Outbound Email Interface & Service Providers ───────────
# Active email provider: 'auto' | 'termii' | 'simpu' | 'customer_io' | 'simulated'
# 'auto' prioritises Termii -> Simpu -> Customer.io, falling back to simulated
# if no external credentials are configured.
EMAIL_PROVIDER=auto
EMAIL_FROM=devcircle@creditdirect.ng
EMAIL_FROM_NAME="Credit Direct Dev Circle"
EMAIL_REPLY_TO=devrelations@creditdirect.ng

# ─── Any REST email service ──────────────────────────────────────────
# For whichever provider you have been given an API key for. Set the URL and
# the key; everything below them only matters where that vendor names a field
# differently. Covers the flat-payload services — Resend, Postmark, Brevo,
# MailerSend and most smaller ones.
#
# SendGrid and Mailgun do not fit: SendGrid nests the recipient inside
# personalizations[0].to[0].email, and Mailgun takes form encoding rather than
# JSON. Those need a provider of their own — src/services/email/providers/
# holds the worked examples and each is about a hundred lines.
#
# EMAIL_PROVIDER=http
# EMAIL_HTTP_URL=
# EMAIL_HTTP_API_KEY=
#
# Defaults suit an `Authorization: Bearer <key>` API with to/from/subject/html
# at the top level. Override only what your vendor spells differently:
#
# EMAIL_HTTP_AUTH_HEADER=Authorization   # header the key goes in
# EMAIL_HTTP_AUTH_SCHEME=Bearer          # set empty for a bare key in a header
# EMAIL_HTTP_FIELD_TO=to
# EMAIL_HTTP_FIELD_FROM=from
# EMAIL_HTTP_FIELD_SUBJECT=subject
# EMAIL_HTTP_FIELD_HTML=html
# EMAIL_HTTP_FIELD_TEXT=text
# EMAIL_HTTP_FIELD_REPLY_TO=reply_to
# EMAIL_HTTP_TO_AS_ARRAY=false           # true where the vendor insists on a list
# EMAIL_HTTP_FROM_WITH_NAME=true         # false for a bare address, no display name
# EMAIL_HTTP_REF_PATH=id                 # dotted path to their message id
# EMAIL_HTTP_EXTRA={}                    # JSON merged into every send
#
# Worked examples — three real services, for shape rather than endorsement:
#
#   Resend
#     EMAIL_HTTP_URL=https://api.resend.com/emails
#     EMAIL_HTTP_API_KEY=re_...
#
#   Postmark
#     EMAIL_HTTP_URL=https://api.postmarkapp.com/email
#     EMAIL_HTTP_API_KEY=...
#     EMAIL_HTTP_AUTH_HEADER=X-Postmark-Server-Token
#     EMAIL_HTTP_AUTH_SCHEME=
#     EMAIL_HTTP_FIELD_TO=To
#     EMAIL_HTTP_FIELD_FROM=From
#     EMAIL_HTTP_FIELD_SUBJECT=Subject
#     EMAIL_HTTP_FIELD_HTML=HtmlBody
#     EMAIL_HTTP_FIELD_TEXT=TextBody
#     EMAIL_HTTP_REF_PATH=MessageID
#     EMAIL_HTTP_EXTRA={"MessageStream":"outbound"}
#
#   Brevo
#     EMAIL_HTTP_URL=https://api.brevo.com/v3/smtp/email
#     EMAIL_HTTP_API_KEY=xkeysib-...
#     EMAIL_HTTP_AUTH_HEADER=api-key
#     EMAIL_HTTP_AUTH_SCHEME=
#     EMAIL_HTTP_FIELD_HTML=htmlContent
#     EMAIL_HTTP_TO_AS_ARRAY=true
#     EMAIL_HTTP_REF_PATH=messageId

# Termii Email Integration (https://termii.com)
TERMII_API_KEY=
TERMII_EMAIL_CONFIGURATION_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_TEMPLATE_ID=

# Simpu Email Integration (https://simpu.co)
SIMPU_API_KEY=
SIMPU_SENDER_ID=devcircle@creditdirect.ng
SIMPU_FROM_NAME="Credit Direct Dev Circle"
# SIMPU_BASE_URL=https://api.simpu.co

# Reserved for direct provider integration if Customer.io is bypassed
WHATSAPP_API_TOKEN=
SMS_API_KEY=

# Feex needs no credential here: it owns support tickets end to end and posts
# them into Dev Circle for engagement visibility. Issue an integration API key
# with the "feex" scope from the admin console for it to authenticate with.

# Comma-separated origin allowlist. '*' is rejected in production.
CORS_ORIGINS=*

# ─── Whose software this is ──────────────────────────────────
# The platform's own identity: the sign-in page, which renders before anybody
# is known and so has no circle to name, every browser tab, and the foot of
# every email. A circle's own name and logo take over the chrome once somebody
# has signed in — those are set per circle in the admin console, not here.
#
# Defaults are Credit Direct's own; set these only to rebrand a deployment.
# BRAND_PRODUCT=Dev Circle
# BRAND_ORG=Credit Direct
# BRAND_FULL=Credit Direct Dev Circle
# BRAND_LEGAL=Credit Direct Limited · CBN Licensed
# BRAND_URL=https://creditdirect.ng
#
# Credit Direct's lockup ships in public/assets/brand and is the default mark,
# in a light and a dark ink so it reads on either theme. Set this only to use a
# different logo — it replaces both inks, so it must read on both.
# BRAND_LOGO_URL=

# ─── First-run accounts ──────────────────────────────────────
# On boot, create the roles, the default circle and a first super admin if they
# are missing. Insert-only: an account that already exists is never rewritten,
# so a password changed in the admin screens survives a restart. Set false once
# the environment has its real accounts.
# SEED_DEMO_ACCOUNTS=true

# ─── API sandbox ─────────────────────────────────────────────
# A throwaway database the API reference can be pointed at, so a developer can
# send real requests — including destructive ones — without touching the member
# base or sending anybody a message. Nothing is dispatched to a provider from
# it. Set to false to remove the option entirely.
SANDBOX_ENABLED=true
# Defaults to the live database path with "-sandbox" appended (SQLite).
# For Postgres: set DEVCIRCLE_SANDBOX_DATABASE_URL to a separate DB, or leave
# blank to use a prefixed schema in the same Postgres.
DEVCIRCLE_SANDBOX_DB_PATH=
