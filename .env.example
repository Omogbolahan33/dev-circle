# Dev Circle configuration
# Copy to .env and fill in. In development every value below has a safe
# fallback; in production the server refuses to start without the secrets.

NODE_ENV=development
PORT=3000

# Shared secret used to verify SSO handoff tokens minted by the Developer Hub.
# Must match the value configured on the Hub side. Required in production.
DEV_HUB_SSO_SECRET=
# Reject handoff tokens older than this many seconds (replay window)
DEV_HUB_TOKEN_MAX_AGE_SEC=300
# Create a Dev Circle profile the first time a Hub developer signs in
DEV_HUB_AUTO_PROVISION=true

# Session lifetime for Dev Circle's own tokens
SESSION_TTL_HOURS=24

# Customer.io transactional API. Without these, outbound email/WhatsApp/SMS
# deliveries are recorded as "simulated" rather than reported as sent.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_API_KEY=

# Reserved for direct provider integration if Customer.io is bypassed
WHATSAPP_API_TOKEN=
SMS_API_KEY=

# Feex needs no credential here: it owns support tickets end to end and posts
# them into Dev Circle for engagement visibility. Issue an integration API key
# with the "feex" scope from the admin console for it to authenticate with.

# Comma-separated origin allowlist. '*' is rejected in production.
CORS_ORIGINS=*
